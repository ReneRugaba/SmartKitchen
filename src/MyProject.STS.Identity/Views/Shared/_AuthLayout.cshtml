@using Microsoft.AspNetCore.Mvc.Localization
@using MyProject.STS.Identity.Configuration.Interfaces
@inject IViewLocalizer Localizer
@inject IRootConfiguration RootConfiguration

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localizer["PageTitle"] - @RootConfiguration.AdminConfiguration.PageTitle</title>
    <link rel="icon" type="image/x-icon" href="@UrlHelper.Content(RootConfiguration.AdminConfiguration.FaviconUri)" />
    <link rel="shortcut icon" type="image/x-icon"
          href="@UrlHelper.Content(RootConfiguration.AdminConfiguration.FaviconUri)" />
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link href="~/css/app.css" asp-append-version="true" rel="stylesheet" />
    @await RenderSectionAsync("styles", required: false)
</head>

<body class="auth-responsive-container">
    <!-- Panneau Gauche - Branding (Desktop/Tablette uniquement) -->
    <div class="auth-responsive-left-panel">
        <div class="auth-responsive-left-overlay"></div>

        <!-- Logo et Header (Tous devices avec panneau gauche) -->
        <div class="auth-responsive-left-content">
            <div class="auth-responsive-logo mb-6">
                <img src="~/icons/logoSmartKitchen.svg" alt="SmartKitchen" class="w-16 h-16" />
            </div>
            <div class="flex flex-col gap-2">
                <h1 class="auth-responsive-title">@Localizer["BrandTitle"]</h1>
                <p class="auth-responsive-subtitle">@Localizer["BrandSubtitle"]</p>
            </div>
        </div>

        <!-- Main Text (Desktop uniquement) -->
        <div class="auth-responsive-left-content hidden lg:block mt-6">
            <h2 class="auth-responsive-main-text">@Localizer["MainTitle"]</h2>
            <p class="auth-responsive-description">
                @Localizer["MainDescription"]
            </p>
        </div>

        <!-- Social Proof (Desktop uniquement) -->
        <div class="auth-responsive-social-proof hidden lg:flex">
            <div class="auth-responsive-avatar-group">
                <img src="~/images/f2b3193647d82c98bb785a6637a1a5b04b79a501.png" alt="User"
                     class="auth-responsive-avatar" />
                <img src="~/images/f2b3193647d82c98bb785a6637a1a5b04b79a501.png" alt="User"
                     class="auth-responsive-avatar -ml-3" />
                <img src="~/images/f2b3193647d82c98bb785a6637a1a5b04b79a501.png" alt="User"
                     class="auth-responsive-avatar -ml-3" />
            </div>
            <p class="auth-responsive-proof-text">@Localizer["SocialProof"]</p>
        </div>
    </div>

    <!-- Panneau Droit - Formulaire -->
    <div class="auth-responsive-right-panel">
        <div class="auth-responsive-form-container">
            @RenderBody()
        </div>

        <!-- Footer -->
        <p class="auth-footer-text">
            @Localizer["SecuredBySmartKitchen"]
        </p>
    </div>

    @await RenderSectionAsync("scripts", required: false)
</body>

</html>
